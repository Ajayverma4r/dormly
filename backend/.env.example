NODE_ENV=development
PORT=4000

DATABASE_URL=postgres://dormly:dormly@localhost:5432/dormly

JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

OTP_TTL_SECONDS=300
OTP_PROVIDER=console

# Razorpay — use Test Mode keys (rzp_test_…) until launch
# https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Set this in Razorpay Dashboard → Webhooks → Secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# When true: OTP console bypass + Pay / Test Activate work without live charge
OTP_BYPASS=true
OTP_PROVIDER=console
# Optional explicit flag (also auto-enabled when RAZORPAY_KEY_ID starts with rzp_test_)
ALLOW_TEST_ACTIVATE=true

# Days of grace after a payment failure before downgrading to free (default: 3)
SUBSCRIPTION_GRACE_PERIOD_DAYS=3

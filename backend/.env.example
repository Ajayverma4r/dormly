NODE_ENV=development
PORT=4000

DATABASE_URL=postgres://dormly:dormly@localhost:5432/dormly

JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

OTP_TTL_SECONDS=300
OTP_PROVIDER=console

# Razorpay — use Test Mode keys (rzp_test_…) until launch
# https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Set this in Razorpay Dashboard → Webhooks → Secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# When true: OTP console bypass + Pay / Test Activate work without live charge
OTP_BYPASS=true
OTP_PROVIDER=console
# Optional explicit flag (also auto-enabled when RAZORPAY_KEY_ID starts with rzp_test_)
ALLOW_TEST_ACTIVATE=true

# Days of grace after a payment failure before downgrading to free (default: 3)
SUBSCRIPTION_GRACE_PERIOD_DAYS=3

# --- Deployment safety switches: all default to false; only "true" enables ---
# Startup always runs a read-only schema check and refuses to start if required
# objects (migrations 016–019, 025; 026 optional) are missing.
# true = startup and request paths may ALTER/CREATE schema (idempotent).
DB_SCHEMA_AUTO_MIGRATE=false
# true = once 026 is applied, relabel old-build one-day charges and DROP the
# legacy invoices_tenancy_period_start_uniq index at startup. Enable for one start.
LEGACY_INVOICE_INDEX_CLEANUP=false
# In-process hourly hostel billing (drafts, status refresh, overdue notices).
# Use this OR the external cron below, never both.
BILLING_SCHEDULER_ENABLED=false
BILLING_SCHEDULER_RUN_ON_BOOT=false
# In-process subscription downgrade (hourly) and 7-day expiry warning (daily).
# No external endpoint exists for these: enable on exactly one instance.
SUBSCRIPTION_JOBS_ENABLED=false
SUBSCRIPTION_JOBS_RUN_ON_BOOT=false
# External billing cron: POST /v1/internal/billing/run with header
# x-cron-secret: <CRON_SECRET>. Endpoint returns 404 while unset.
# CRON_SECRET=

# --- Uploaded files (photos, agreements, Aadhaar/ID documents) ---
# local (default) keeps files in backend/uploads, which Render wipes on every
# deploy/restart. supabase stores them in a PRIVATE Supabase Storage bucket.
FILE_STORAGE_DRIVER=local
# SUPABASE_URL=https://<project-ref>.supabase.co
# Service role key: server-only, never ship it in the mobile app.
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=dormly-uploads
